<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Disable Firebase Analytics / telemetry (effective if the Analytics SDK is ever linked;
	     do NOT add the FirebaseAnalytics pod — FirebaseMessaging alone collects no analytics). -->
	<key>FIREBASE_ANALYTICS_COLLECTION_DEACTIVATED</key>
	<true/>
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>de.tabmates.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tabmates</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
